{
  "name": "herdr-plugins",
  "version": "0.1.0",
  "private": true,
  "description": "Independent herdr plugins extending the herdr ecosystem (rebuildup)",
  "type": "module",
  "workspaces": [
    "packages/*",
    "plugins/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test",
    "lint": "bunx @biomejs/biome check .",
    "format": "bunx @biomejs/biome check --write .",
    "validate:fast": "bun run typecheck && bun run lint && bun run test",
    "validate:integration": "bun run validate:fast"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.4",
    "@types/bun": "1.3.14",
    "typescript": "5.9.3"
  }
}
